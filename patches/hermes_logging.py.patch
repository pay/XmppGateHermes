diff --git a/hermes_logging.py b/hermes_logging.py
index d371af2..f458f9d 100644
--- a/hermes_logging.py
+++ b/hermes_logging.py
@@ -238,7 +238,13 @@ COMPONENT_PREFIXES = {
     # out of ``gateway/platforms/`` into bundled plugins (#41112) — they are
     # still gateway components and their logs belong in gateway.log / match
     # ``hermes logs --component gateway``.
-    "gateway": ("gateway", "hermes_plugins", "plugins.platforms"),
+    # ``hermes_xmpp`` is a directory plugin under ``~/.hermes/plugins/`` whose
+    # adapter package is importable as a top-level module (the plugin
+    # ``__init__.py`` puts its own dir on ``sys.path``), so ``getLogger(__name__)``
+    # resolves to ``hermes_xmpp.adapter`` and never matches ``hermes_plugins.*``.
+    # Without this prefix every XMPP record (MUC join failures included) was
+    # dropped from gateway.log and only visible in errors.log / agent.log.
+    "gateway": ("gateway", "hermes_plugins", "plugins.platforms", "hermes_xmpp"),
     "agent": ("agent", "run_agent", "model_tools", "batch_runner"),
     "tools": ("tools",),
     "cli": ("hermes_cli", "cli"),
